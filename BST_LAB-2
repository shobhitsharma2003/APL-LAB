    cout << "After deleting leaf node 10: ";
    inorder(root);
    cout << "\n";

    freeTree(root);

    // Delete node with one child
    root = makeTree();

    root = deleteNode(root, 20);

    cout << "After deleting node 20 (one child): ";
    inorder(root);
    cout << "\n";

