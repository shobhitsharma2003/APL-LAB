         << setw(10) << "Height"
         << setw(15) << "Search(ms)"
         << setw(15) << "Delete(ms)"
         << "\n";

    cout << "------------------------------------------------------------------\n";

    int sizes[] = {1000, 5000, 10000};

    for (int t = 0; t < 3; t++)
    {
        for (int s = 0; s < 3; s++)
        {
            int n = sizes[s];

            vector<int> a(n);

            for (int i = 0; i < n; i++)
